generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String
  createdAt    DateTime @default(now())

  sessions           Session[]
  classes            Class[]         @relation("ClassTeacher")
  children           ParentStudent[]
  paymentsRegistered Payment[]
  expenses           Expense[]
  monthCloses        MonthClose[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model SchoolYear {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  classes  Class[]
  holidays Holiday[]
  expenses Expense[]
}

model Holiday {
  id           String     @id @default(cuid())
  schoolYearId String
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  date         DateTime
  name         String

  @@unique([schoolYearId, date])
}

model Class {
  id               String     @id @default(cuid())
  name             String
  schoolYearId     String
  schoolYear       SchoolYear @relation(fields: [schoolYearId], references: [id])
  teacherId        String?
  teacher          User?      @relation("ClassTeacher", fields: [teacherId], references: [id])
  dailyFoodRate    Int
  dailyDaycareRate Int        @default(27000)
  annualFundAmount Int
  // Shown to the class's parents as a scrolling banner; empty means no announcement.
  announcement     String     @default("")
  announcementAt   DateTime?

  students    Student[]
  monthCloses MonthClose[]
  expenses    Expense[]
  lessonSlots LessonSlot[]
  periodTimes PeriodTime[]

  @@unique([schoolYearId, name])
}

model Student {
  id       String  @id @default(cuid())
  classId  String
  class    Class   @relation(fields: [classId], references: [id])
  name     String
  isActive Boolean @default(true)
  // Өдөр өнжүүлэх enrolment window (inclusive). No start date means not enrolled; no end date means until the school year ends.
  daycareFrom  DateTime?
  daycareUntil DateTime?

  parents         ParentStudent[]
  attendance      Attendance[]
  daycareDays     DaycareAttendance[]
  daycareSkips    DaycareSkip[]
  invoices        FoodInvoice[]
  daycareInvoices DaycareInvoice[]
  payments        Payment[]
}

model ParentStudent {
  parentUserId String
  parent       User    @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentUserId, studentId])
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  status    String

  @@unique([studentId, date])
}

// Legacy: days ticked as "stayed" under the old pay-per-day Өдөр өнжүүлэх rule. No longer read by the app;
// kept so old records are not lost. `npm run db:daycare-convert` turns them into enrolment + skipped days.
model DaycareAttendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime

  @@unique([studentId, date])
}

// A school day an enrolled student did not stay for Өдөр өнжүүлэх. The month is prepaid in full,
// so each skipped day is deducted (at the daily rate) from the following month's charge.
model DaycareSkip {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime

  @@unique([studentId, date])
}

model MonthClose {
  id         String   @id @default(cuid())
  classId    String
  class      Class    @relation(fields: [classId], references: [id])
  year       Int
  month      Int
  closedAt   DateTime @default(now())
  closedById String
  closedBy   User     @relation(fields: [closedById], references: [id])

  invoices        FoodInvoice[]
  daycareInvoices DaycareInvoice[]

  @@unique([classId, year, month])
}

model FoodInvoice {
  id           String     @id @default(cuid())
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])
  monthCloseId String
  monthClose   MonthClose @relation(fields: [monthCloseId], references: [id], onDelete: Cascade)
  year         Int
  month        Int
  daysPresent  Int
  rate         Int
  amount       Int
  createdAt    DateTime   @default(now())

  @@unique([studentId, year, month])
}

model DaycareInvoice {
  id           String     @id @default(cuid())
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])
  monthCloseId String
  monthClose   MonthClose @relation(fields: [monthCloseId], references: [id], onDelete: Cascade)
  year         Int
  month        Int
  // Prepaid rule: school days charged for the month. (Old pay-per-day invoices: days stayed.)
  daysPresent  Int
  // Days taken off this month's charge for days skipped earlier. amount = (daysPresent - deductedDays) * rate.
  deductedDays Int        @default(0)
  rate         Int
  amount       Int
  createdAt    DateTime   @default(now())

  @@unique([studentId, year, month])
}

model Payment {
  id             String    @id @default(cuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id])
  kind           String
  amount         Int
  paidAt         DateTime
  note           String    @default("")
  registeredById String
  registeredBy   User      @relation(fields: [registeredById], references: [id])
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?
  deleteReason   String?
}

model Expense {
  id           String     @id @default(cuid())
  classId      String
  class        Class      @relation(fields: [classId], references: [id])
  schoolYearId String
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id])
  date         DateTime
  title        String
  amount       Int
  note         String     @default("")
  createdById  String
  createdBy    User       @relation(fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())
}

model LessonSlot {
  id      String @id @default(cuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  weekday Int
  period  Int
  subject String
  note    String @default("")

  @@unique([classId, weekday, period])
}

model PeriodTime {
  id        String  @id @default(cuid())
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  period    Int
  startTime String?
  endTime   String?

  @@unique([classId, period])
}
